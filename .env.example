# Copy this file to `.env` and fill in local values. Never commit `.env`.

DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional. Defaults to ./db.sqlite3
# DJANGO_DB_PATH=db.sqlite3

# Transport Data eXchange (https://tdx.transportdata.tw/)
# Needed only when running: python manage.py fetch_tdx
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Optional extra TDX apps, used in round-robin if the first pair is rate-limited.
# TDX_CLIENT_ID_2=
# TDX_CLIENT_SECRET_2=
